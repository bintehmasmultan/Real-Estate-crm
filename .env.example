# Firebase Web (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=estate-crm-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=estate-crm-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=estate-crm-web.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=687650644413
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — from Firebase Console > Project settings > Service accounts
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional. npm run db:seed already refuses NODE_ENV/VERCEL_ENV/FIREBASE_ENV=production.
# Comma-separated project ids that must also be treated as production:
# PRODUCTION_FIREBASE_PROJECT_IDS=estate-crm-web
# Wipe override, off by default: ALLOW_PROD_SEED=true
