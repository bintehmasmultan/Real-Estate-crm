generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("AGENT") // ADMIN | MANAGER | AGENT
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedContacts Contact[]  @relation("ContactAgent")
  listedProperties Property[] @relation("ListingAgent")
  assignedLeads    Lead[]     @relation("LeadAgent")
  deals            Deal[]     @relation("DealAgent")
  tasks            Task[]     @relation("TaskAssignee")
  createdTasks     Task[]     @relation("TaskCreator")
  activities       Activity[]
  notes            Note[]
  managedTeam      Team?      @relation("TeamManager")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  managerId String?  @unique
  manager   User?    @relation("TeamManager", fields: [managerId], references: [id])
  members   User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  whatsapp          String?
  address           String?
  city              String?
  type              String   @default("BUYER") // BUYER | SELLER | LANDLORD | TENANT | INVESTOR
  status            String   @default("ACTIVE") // ACTIVE | INACTIVE | LEAD | CLIENT | ARCHIVED
  source            String? // WEBSITE | FACEBOOK | REFERRAL | WALK_IN | ZAMEEN | OLX | OTHER
  tags              String   @default("[]")
  notes             String?
  budgetMin         Float?
  budgetMax         Float?
  preferredLocation String?
  preferredType     String?
  beds              Int?
  baths             Int?
  preferenceNotes   String?
  assignedAgentId   String?
  assignedAgent     User?    @relation("ContactAgent", fields: [assignedAgentId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ownedProperties Property[]        @relation("PropertyOwner")
  interestedIn    ContactProperty[]
  deals           Deal[]
  leads           Lead[]
  tasks           Task[]
  activities      Activity[]
  notesList       Note[]
}

model Property {
  id             String   @id @default(cuid())
  title          String
  address        String
  city           String
  type           String   @default("APARTMENT") // APARTMENT | HOUSE | PLOT | COMMERCIAL
  status         String   @default("AVAILABLE") // AVAILABLE | UNDER_OFFER | SOLD | RENTED | OFF_MARKET
  price          Float
  area           Float?
  areaUnit       String   @default("sqft")
  beds           Int?
  baths          Int?
  description    String?
  photos         String   @default("[]")
  documents      String   @default("[]")
  listingAgentId String?
  listingAgent   User?    @relation("ListingAgent", fields: [listingAgentId], references: [id])
  ownerContactId String?
  ownerContact   Contact? @relation("PropertyOwner", fields: [ownerContactId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  interestedContacts ContactProperty[]
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  notesList          Note[]
}

model ContactProperty {
  id         String   @id @default(cuid())
  contactId  String
  propertyId String
  interest   String?
  createdAt  DateTime @default(now())

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([contactId, propertyId])
}

model Lead {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  source            String   @default("WEBSITE")
  status            String   @default("NEW") // NEW | CONTACTED | QUALIFIED | UNQUALIFIED | CONVERTED | LOST
  score             Int      @default(50)
  message           String?
  budget            Float?
  preferredType     String?
  preferredLocation String?
  assignedAgentId   String?
  assignedAgent     User?    @relation("LeadAgent", fields: [assignedAgentId], references: [id])
  contactId         String?
  contact           Contact? @relation(fields: [contactId], references: [id])
  convertedDealId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activities Activity[]
  tasks      Task[]
}

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  order     Int
  pipeline  String // SALES | RENTALS
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals Deal[]

  @@unique([pipeline, order])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  pipeline          String    @default("SALES")
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  value             Float     @default(0)
  probability       Int       @default(50)
  expectedCloseDate DateTime?
  contactId         String?
  contact           Contact?  @relation(fields: [contactId], references: [id])
  propertyId        String?
  property          Property? @relation(fields: [propertyId], references: [id])
  agentId           String?
  agent             User?     @relation("DealAgent", fields: [agentId], references: [id])
  notes             String?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tasks      Task[]
  activities Activity[]
  notesList  Note[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime?
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status      String    @default("TODO") // TODO | IN_PROGRESS | DONE | CANCELLED
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Activity {
  id          String    @id @default(cuid())
  type        String    @default("NOTE") // CALL | EMAIL | MEETING | VIEWING | NOTE | STATUS_CHANGE | OTHER
  subject     String?
  body        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id])
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
}

model Note {
  id         String    @id @default(cuid())
  body       String
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id])
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id])
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
